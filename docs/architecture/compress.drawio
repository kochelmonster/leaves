                </mxCell>
                <mxCell id="1305" value="&lt;b&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;Compression step 2&lt;/font&gt;&lt;br&gt;&lt;/b&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;drop the 5 words that are entirely zero; keep only the 3 non-empty words,&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;packed contiguously, plus a 1-byte index of which of the 8 words survived.&lt;/span&gt;&lt;/div&gt;" style="text;strokeColor=none;align=left;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=0" vertex="1" parent="1">
                    <mxGeometry x="475" y="615" width="495" height="80" as="geometry"/>
                </mxCell>
