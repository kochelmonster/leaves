                <mxCell id="1303" value="&lt;b&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;Compression step 1&lt;/font&gt;&lt;br&gt;&lt;/b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;extract the 3 real offsets into a dense array;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;represent presence with a full 256-bit bitmap (8 x 32-bit words).&lt;/font&gt;&lt;/div&gt;" style="text;strokeColor=none;align=left;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=0" vertex="1" parent="1">
