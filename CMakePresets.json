{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-vs18-x64",
      "displayName": "Windows VS18 x64",
      "description": "Default Windows configure path with repository-local dependencies",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "${sourceDir}/vcpkg_installed/x64-windows"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "description": "Linux debug build with Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "description": "Linux release build with Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "default-linux",
      "displayName": "Default Linux Multi-Config",
      "description": "Default profile: tests Debug, benchmarks Release (nested build)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build-default",
      "cacheVariables": {
        "LEAVES_BUILD_TESTS": "ON",
        "LEAVES_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "default-windows",
      "displayName": "Default Windows Multi-Config",
      "description": "Default profile for Debug tests and Release benchmarks",
      "inherits": "windows-vs18-x64",
      "binaryDir": "${sourceDir}/build-default",
      "cacheVariables": {
        "LEAVES_BUILD_TESTS": "ON",
        "LEAVES_BUILD_BENCHMARKS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-vs18-x64-debug",
      "configurePreset": "windows-vs18-x64",
      "configuration": "Debug"
    },
    {
      "name": "windows-vs18-x64-release",
      "configurePreset": "windows-vs18-x64",
      "configuration": "Release"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "default",
      "displayName": "Default (tests Debug, benchmarks Release)",
      "configurePreset": "default-linux",
      "configuration": "Debug"
    },
    {
      "name": "default-windows",
      "displayName": "Default Windows (tests Debug, benchmarks Release)",
      "configurePreset": "default-windows",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "output": { "outputOnFailure": true }
    }
  ],
  "workflowPresets": [
    {
      "name": "default",
      "displayName": "Default",
      "description": "Configure once, build tests in Debug and benchmarks in Release",
      "steps": [
        {
          "type": "configure",
          "name": "default-linux"
        },
        {
          "type": "build",
          "name": "default"
        }
      ]
    },
    {
      "name": "default-windows",
      "displayName": "Default Windows",
      "description": "Configure once, build tests in Debug and benchmarks in Release",
      "steps": [
        {
          "type": "configure",
          "name": "default-windows"
        },
        {
          "type": "build",
          "name": "default-windows"
        }
      ]
    }
  ]
}
