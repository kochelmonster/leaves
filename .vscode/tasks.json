			"label": "Reconfigure and build test_mmap build",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"Get-Process cmake,vcpkg -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue; cmake --fresh -S . -B build -G 'Visual Studio 18 2026' -A x64 -DCMAKE_PREFIX_PATH='${workspaceFolder}\\vcpkg_installed\\x64-windows' -DLEAVES_BUILD_TESTS=ON -DLEAVES_BUILD_BENCHMARKS=OFF; cmake --build build --target test_mmap --config Debug -j"
			],
			"isBackground": false
		},
