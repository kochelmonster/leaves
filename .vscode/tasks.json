{
	"tasks": [
		{
			"type": "cppbuild",
			"label": "C/C++: g++ build active file",
			"command": "/usr/bin/g++",
			"args": [
				"-fdiagnostics-color=always",
				"-g",
				"${file}",
				"-o",
				"${fileDirname}/${fileBasenameNoExtension}"
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build"
			},
			"detail": "Task generated by Debugger."
		},
		{
			"label": "Configure leaves (CMake, benchmarks ON)",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--fresh",
				"-S",
				".",
				"-B",
				"build",
				"-G",
				"Visual Studio 18 2026",
				"-A",
				"x64",
				"-DCMAKE_PREFIX_PATH=${workspaceFolder}\\vcpkg_installed\\x64-windows",
				"-DLEAVES_BUILD_BENCHMARKS=ON"
			],
			"isBackground": false,
			"problemMatcher": [
				"$gcc"
			]
		},
		{
			"label": "Build leaves (CMake, F7 default)",
			"type": "shell",
			"command": "cmake --build build -j",
			"isBackground": false,
			"dependsOn": [
				"Configure leaves (CMake, benchmarks ON)"
			],
			"dependsOrder": "sequence",
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "Copy YCSB backup for debug",
			"type": "shell",
			"command": "cp",
			"args": [
				"/home/michael/src/YCSB/leaves/ycsb.lvs.bak",
				"/home/michael/src/leaves/tests/ycsb-bug/ycsb.lvs"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "silent",
				"focus": false,
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "Build test_mmap direct",
			"type": "shell",
